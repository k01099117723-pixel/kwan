# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="development"

# JWT Authentication Secret for Admin Panel
JWT_SECRET="kwan_studio_super_secret_jwt_key_2026_change_in_production"

# Default Initial Admin Credentials (used if no admin exists)
ADMIN_INITIAL_EMAIL="admin@kwanstudio.ma"
ADMIN_INITIAL_PASSWORD="AdminPassword2026!"

# MySQL Database Configuration (for Hostinger or production MySQL)
# Leave blank to use internal file-based durable store during local dev/preview
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME="kwan_studio_db"

